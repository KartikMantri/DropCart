# Copy to .env.local and fill in. Every service below has a free tier.

# --- Database: Supabase Postgres (Project Settings → Database → Connection string)
# Pooled "Transaction" connection (port 6543) — used by the app at runtime.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct / "Session" connection (port 5432) — used by `prisma migrate`.
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- Auth: Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by the seed script to create the demo user.
SUPABASE_SERVICE_ROLE_KEY=

# --- LLM: Groq primary (console.groq.com/keys), Gemini fallback (aistudio.google.com/apikey)
GROQ_API_KEY=
GEMINI_API_KEY=
# Optional model overrides
# GROQ_MODEL=openai/gpt-oss-120b
# GEMINI_MODEL=gemini-2.5-flash

# --- Products: Channel3 (trychannel3.com/dashboard) — 1,000 searches/month free
CHANNEL3_API_KEY=

# --- Payments: PayPal sandbox (developer.paypal.com → Apps & Credentials → Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# --- Scheduler: shared secret for POST /api/cron/check (any long random string)
CRON_SECRET=

# --- Demo: enables "Check now" and the price override (shown with a DEMO MODE badge)
DEMO_MODE=true

# Optional: override the published demo login
# DEMO_USER_EMAIL=demo@dropcart.dev
# DEMO_USER_PASSWORD=dropcart-demo-2026
